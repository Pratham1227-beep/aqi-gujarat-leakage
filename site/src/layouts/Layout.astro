---
interface Props {
  title: string;
  activeSlug?: string;
}

const { title, activeSlug } = Astro.props;

const navItems = [
  { slug: '', title: 'Overview' },
  { slug: 'protocol', title: 'Experimental Protocol' },
  { slug: 'data_availability', title: 'Data Availability' },
  { slug: 'cpcb_breakpoints', title: 'CPCB Breakpoints' },
  { slug: 'decisions', title: 'Decisions Log' },
  { slug: 'paper_outline', title: 'Manuscript Outline' },
];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Gujarat AQI Benchmarking Documentation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --md-surface: #f8fafc;
        --md-surface-card: #ffffff;
        --md-on-surface: #0f172a;
        --md-on-surface-variant: #475569;
        --md-primary: #1e3a8a;
        --md-primary-container: #eff6ff;
        --md-on-primary-container: #1d4ed8;
        --md-outline-soft: #f1f5f9;
        --shadow-elevation-1: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.03);
        --shadow-elevation-2: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--md-surface);
        color: var(--md-on-surface);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--md-on-primary-container);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      /* Top App Bar */
      .app-bar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        box-shadow: var(--shadow-elevation-1);
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
      }

      .app-bar-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--md-on-surface);
      }

      .badge-tag {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        background: var(--md-primary-container);
        color: var(--md-on-primary-container);
        border-radius: 9999px;
      }

      .app-bar-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
      }

      .app-bar-links a {
        color: var(--md-on-surface-variant);
        transition: color 0.15s ease;
      }

      .app-bar-links a:hover {
        color: var(--md-primary);
        text-decoration: none;
      }

      /* Layout Grid */
      .layout-container {
        display: flex;
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        gap: 2.5rem;
      }

      /* Sidebar Navigation (Material Navigation Drawer / Rail) */
      .sidebar {
        width: 260px;
        flex-shrink: 0;
        position: sticky;
        top: 96px;
        height: fit-content;
      }

      .sidebar-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--md-on-surface-variant);
        margin-bottom: 0.75rem;
        padding: 0 0.75rem;
      }

      .nav-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .nav-link {
        display: block;
        padding: 0.625rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--md-on-surface-variant);
        border-radius: 9999px; /* Material 3 Pill shape */
        transition: background 0.15s ease, color 0.15s ease;
      }

      .nav-link:hover {
        background: rgba(0, 0, 0, 0.04);
        color: var(--md-on-surface);
        text-decoration: none;
      }

      .nav-link.active {
        background: var(--md-primary-container);
        color: var(--md-on-primary-container);
        font-weight: 600;
      }

      /* Main Content Surface */
      .content-pane {
        flex: 1;
        min-width: 0;
        background: var(--md-surface-card);
        border-radius: 16px;
        padding: 2.5rem 3rem;
        box-shadow: var(--shadow-elevation-1);
      }

      /* Markdown Prose Typography */
      .markdown-body h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
        color: var(--md-on-surface);
      }

      .markdown-body h2 {
        font-size: 1.4rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: var(--md-on-surface);
      }

      .markdown-body h3 {
        font-size: 1.15rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
      }

      .markdown-body p {
        margin-bottom: 1rem;
        color: var(--md-on-surface-variant);
      }

      .markdown-body ul, .markdown-body ol {
        margin-left: 1.5rem;
        margin-bottom: 1.25rem;
        color: var(--md-on-surface-variant);
      }

      .markdown-body li {
        margin-bottom: 0.35rem;
      }

      .markdown-body blockquote {
        border-left: 4px solid var(--md-on-primary-container);
        background: var(--md-surface);
        padding: 0.875rem 1.25rem;
        margin: 1.25rem 0;
        border-radius: 0 8px 8px 0;
        color: var(--md-on-surface-variant);
      }

      .markdown-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.875rem;
      }

      .markdown-body th {
        background: var(--md-surface);
        padding: 0.75rem 1rem;
        text-align: left;
        font-weight: 600;
        color: var(--md-on-surface);
        border-bottom: 1px solid #e2e8f0;
      }

      .markdown-body td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        color: var(--md-on-surface-variant);
      }

      .markdown-body tr:hover td {
        background: rgba(0, 0, 0, 0.015);
      }

      .markdown-body pre {
        background: #0f172a;
        color: #f8fafc;
        padding: 1.25rem;
        border-radius: 12px;
        overflow-x: auto;
        font-family: 'Roboto Mono', monospace;
        font-size: 0.875rem;
        margin: 1.5rem 0;
      }

      .markdown-body code {
        font-family: 'Roboto Mono', monospace;
        font-size: 0.85em;
        padding: 0.15rem 0.35rem;
        background: #f1f5f9;
        color: #0f172a;
        border-radius: 4px;
      }

      .markdown-body pre code {
        background: transparent;
        color: inherit;
        padding: 0;
      }

      @media (max-width: 860px) {
        .layout-container {
          flex-direction: column;
          padding: 1rem;
        }

        .sidebar {
          width: 100%;
          position: static;
        }

        .content-pane {
          padding: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="app-bar">
      <a href={`${baseUrl}/`} class="app-bar-brand">
        <span>Gujarat AQI Benchmark</span>
        <span class="badge-tag">Documentation</span>
      </a>
      <div class="app-bar-links">
        <a href="https://github.com/Pratham1227-beep/aqi-gujarat-leakage" target="_blank" rel="noopener">
          GitHub
        </a>
      </div>
    </header>

    <div class="layout-container">
      <aside class="sidebar">
        <div class="sidebar-title">Documentation</div>
        <ul class="nav-list">
          {
            navItems.map((item) => {
              const href = item.slug === '' ? `${baseUrl}/` : `${baseUrl}/${item.slug}/`;
              const isActive = (activeSlug || '') === item.slug;
              return (
                <li>
                  <a href={href} class={`nav-link ${isActive ? 'active' : ''}`}>
                    {item.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>

      <main class="content-pane markdown-body">
        <slot />
      </main>
    </div>
  </body>
</html>
